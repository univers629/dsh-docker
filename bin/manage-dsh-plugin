#!/bin/sh
set -eu

usage() {
  printf '%s\n' '用法：manage-dsh-plugin install|update|remove <package> | restart' >&2
  exit 2
}

fail() {
  printf '【DSH 插件】失败：%s\n' "$*" >&2
  exit 1
}

restart_after_turn() {
  [ "$#" -eq 4 ] || exit 2
  target_pid=$1
  target_start=$2
  session_log=$3
  baseline_bytes=$4

  case "$target_pid:$target_start:$baseline_bytes" in
    ''|*[!0-9:]*|*::*|:*|*:) exit 2 ;;
  esac

  # Wait for the durable turn boundary before stopping the process that owns
  # the current Bash call. The timeout is finite so a missing/stale log cannot
  # prevent the requested plugin change from eventually taking effect.
  if [ -n "$session_log" ] && [ -f "$session_log" ]; then
    attempts=0
    while [ "$attempts" -lt 240 ]; do
      current_bytes=$(wc -c < "$session_log" 2>/dev/null || printf '0')
      case "$current_bytes" in *[!0-9]*|'') current_bytes=0 ;; esac
      if [ "$current_bytes" -gt "$baseline_bytes" ] \
        && tail -c "+$((baseline_bytes + 1))" "$session_log" 2>/dev/null \
          | grep -q '"type":"turn/end"'; then
        break
      fi
      attempts=$((attempts + 1))
      sleep 0.5
    done
  else
    sleep 5
  fi
  sleep 1

  [ -r "/proc/$target_pid/stat" ] || exit 0
  current_start=$(awk '{ print $22 }' "/proc/$target_pid/stat" 2>/dev/null || true)
  [ "$current_start" = "$target_start" ] || exit 0
  command_line=$(tr '\000' ' ' < "/proc/$target_pid/cmdline" 2>/dev/null || true)
  case "$command_line" in
    *'/app/dsh/apps/cli/lib/bin.js'*) kill -TERM "$target_pid" 2>/dev/null || true ;;
  esac
}

[ "${1:-}" != '__restart-after-turn' ] || {
  shift
  restart_after_turn "$@"
  exit 0
}

schedule_restart() {
  pid_file=${DSH_PID_FILE:-/run/dsh.pid}
  [ -r "$pid_file" ] || fail "找不到 DSH 主进程记录：$pid_file"
  target_pid=$(sed -n '1p' "$pid_file")
  case "$target_pid" in ''|*[!0-9]*) fail "DSH 主进程记录无效：$target_pid" ;; esac
  [ -r "/proc/$target_pid/stat" ] || fail "DSH 主进程不存在：$target_pid"
  target_start=$(awk '{ print $22 }' "/proc/$target_pid/stat" 2>/dev/null || true)
  case "$target_start" in ''|*[!0-9]*) fail '无法确认 DSH 主进程的启动标识。' ;; esac
  command_line=$(tr '\000' ' ' < "/proc/$target_pid/cmdline" 2>/dev/null || true)
  case "$command_line" in
    */app/dsh/apps/cli/lib/bin.js*) ;;
    *) fail "PID $target_pid 不是预期的 DSH 主进程。" ;;
  esac

  session_log=${DSH_SESSION_JSONL:-}
  baseline_bytes=0
  if [ -n "$session_log" ] && [ -f "$session_log" ]; then
    baseline_bytes=$(wc -c < "$session_log" 2>/dev/null || printf '0')
    case "$baseline_bytes" in *[!0-9]*|'') baseline_bytes=0 ;; esac
  fi

  case "$0" in
    /*) self=$0 ;;
    *) self=$(command -v "$0" 2>/dev/null || true) ;;
  esac
  [ -n "${self:-}" ] && [ -x "$self" ] || fail '找不到插件管理脚本自身，无法安排自动重启。'
  setsid_bin=${DSH_SETSID_BIN:-/usr/bin/setsid}
  [ -x "$setsid_bin" ] || fail "找不到 setsid：$setsid_bin"

  "$setsid_bin" "$self" __restart-after-turn \
    "$target_pid" "$target_start" "$session_log" "$baseline_bytes" \
    </dev/null >/dev/null 2>&1 &
}

if [ "${1:-}" = restart ]; then
  [ "$#" -eq 1 ] || usage
  printf '%s\n' '【DSH】正在确认 DSH 主进程，并安排本轮回复结束后的优雅重启……'
  schedule_restart
  printf '%s\n' '【DSH】已安排重启：当前回复结束后只会重启 DSH 主进程，不会影响其他 Docker 容器。'
  printf '%s\n' '【DSH】页面会短暂断开；服务恢复后再刷新。重启结果将在下一次检查中确认。'
  exit 0
fi

[ "$#" -eq 2 ] || usage
operation=$1
package=$2

case "$operation" in
  install|update|remove) ;;
  *) usage ;;
esac

case "$package" in
  ''|'-'*) fail '插件包名不能为空，也不能以 - 开头。' ;;
esac

profile=/data/dsh/profiles/web
[ -d "$profile" ] || fail "找不到 web profile：$profile"
cd "$profile"

case "$package" in
  git+*|github:*|http://*|https://*|file:*|link:*|./*|../*|/*|*.tgz) spec=$package ;;
  @*/*)
    scoped_rest=${package#@}
    case "$scoped_rest" in *@*) spec=$package ;; *) spec="${package}@latest" ;; esac
    ;;
  *@*) spec=$package ;;
  *) spec="${package}@latest" ;;
esac

case "$operation" in
  install) verb=安装; pnpm_verb=add; target=$spec ;;
  update) verb=更新; pnpm_verb=update; target=$spec ;;
  remove) verb=删除; pnpm_verb=remove; target=$package ;;
esac

printf '【DSH 插件】开始%s：%s\n' "$verb" "$target"
printf '%s\n' '【DSH 插件】正在执行包管理操作，下面会显示 pnpm/DSH 的实际输出。'
case "$operation" in
  install)
    dsh plugin --profile web add "$target" --ignore-scripts || \
      fail "${verb} ${target} 未完成；DSH 不会自动重启。"
    ;;
  update)
    dsh plugin --profile web update "$target" || \
      fail "${verb} ${target} 未完成；DSH 不会自动重启。"
    ;;
  remove)
    dsh plugin --profile web remove "$target" || \
      fail "${verb} ${target} 未完成；DSH 不会自动重启。"
    ;;
esac

printf '【DSH 插件】包管理操作已完成并写入持久化 web profile：%s\n' "$target"
printf '%s\n' '【DSH 插件】正在校验 web profile 的组合配置……'
if ! dsh --profile web --dump-config >/dev/null; then
  fail "配置解析失败，未确认 ${target} 能随 web profile 启动；DSH 不会自动重启。"
fi

schedule_restart

printf '%s\n' '【DSH 插件】profile 配置解析通过，插件变更已写入持久化 web profile，但前端尚未确认生效。'
printf '%s\n' '【DSH 插件】DSH 会在本轮回复结束后自动重启，并重新链接依赖、加载插件；不会等待重启完成后再补发一条通知。'
printf '%s\n' '【DSH 插件】页面会短暂断开。请等待约 30～60 秒（复杂插件可能接近 1 分钟）后再刷新；过早刷新仍看不到插件属于正常现象。超过 90 秒仍未出现时，再检查最近 500 行日志和插件自身入口。'
