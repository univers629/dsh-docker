#!/bin/sh
# 从标准输入读取一行密码，输出 sha512crypt 哈希。
#
# 安装器用 `docker run --rm -i --entrypoint /usr/local/bin/hash-dsh-password` 调用它，
# 明文密码只经过一次管道，既不写进 .env 也不落到宿主机磁盘。
#
# PowerShell 往原生进程的管道里写的是 CRLF，如果把结尾的 CR 一起哈希，Windows 上
# 生成的哈希就永远对不上用户实际输入的密码。所以这里先剥掉 CR 再交给 openssl。
set -eu

IFS= read -r password || true
password=$(printf '%s' "$password" | tr -d '\r')

if [ -z "$password" ]; then
  echo '[dsh] 密码不能为空' >&2
  exit 2
fi

printf '%s\n' "$password" | openssl passwd -6 -stdin