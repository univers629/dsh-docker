#!/bin/sh
set -eu

name=$(basename "$0")
case "$name" in
  apt) real=/usr/bin/apt ;;
  apt-get) real=/usr/bin/apt-get ;;
  *) real=/usr/bin/apt-get ;;
esac

# Normal-user mode keeps Debian's native behavior and permissions. The
# persistent prefix is intentionally only an opt-in root-mode facility.
if [ "$(id -u)" != 0 ]; then
  exec "$real" "$@"
fi

action=
packages=
after=false
for arg in "$@"; do
  if [ "$after" = true ]; then
    case "$arg" in
      --|-*|./*|../*|/*|http://*|https://*) continue ;;
    esac
    package=${arg%%=*}
    case "$package" in ''|*[!A-Za-z0-9.+:~_-]*) continue ;; esac
    packages="${packages}${packages:+
}${package}"
  else
    case "$arg" in
      install|reinstall) action="$arg"; after=true ;;
    esac
  fi
done

if [ -z "$action" ] || [ -z "$packages" ]; then
  exec "$real" "$@"
fi

root=${DSH_TOOLCHAIN_ROOT:-/data/home/.local/toolchain}
bin=${DSH_TOOLCHAIN_BIN:-/data/home/.local/bin}
cache=${DSH_TOOLCHAIN_APT_CACHE:-/data/home/.cache/dsh/apt/archives}
mkdir -p "$root" "$bin" "$cache/partial"

set --
while IFS= read -r package; do
  [ -n "$package" ] && set -- "$@" "$package"
done <<EOF
$packages
EOF

echo "[dsh] persistent toolchain install: $*"
/usr/bin/apt-get --download-only --no-install-recommends -y \
  -o Dir::Cache::archives="$cache" install "$@"

for archive in "$cache"/*.deb; do
  [ -f "$archive" ] || continue
  /usr/bin/dpkg-deb -x "$archive" "$root"
done

for directory in "$root/bin" "$root/usr/bin" "$root/usr/sbin" "$root/sbin"; do
  [ -d "$directory" ] || continue
  find "$directory" -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -exec sh -c '
    target="$1"; root="$3"; destination="$2/$(basename "$target")"
    if [ -L "$target" ]; then
      link=$(readlink "$target")
      case "$link" in
        /*) candidate="$root$link" ;;
        *) candidate="$(dirname "$target")/$link" ;;
      esac
      [ -e "$candidate" ] && target="$candidate"
    fi
    ln -sfn "$target" "$destination"
  ' sh {} "$bin" "$root" \;
done
echo "[dsh] tools stored under $root and survive container recreation"
