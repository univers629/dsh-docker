# Runtime state and user data. Keep only directory markers in Git.
data/**
!data/**/
!data/**/.gitkeep
workspace/**
!workspace/
!workspace/.gitkeep

# Cloned source, dependency stores, and local build artifacts.
deepseek-harness/
scratch_repos/
node_modules/
.pnpm-store/
.cache/
dist/
build/
*.tsbuildinfo
*.zip
*.log

# Local configuration and editor/OS files.
.env.*
!.env.example
.env
.DS_Store
Thumbs.db
.idea/
.vscode/
