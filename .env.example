# Runtime image reference. prebuilt pulls the published multi-arch image from
# GitHub Packages so a small VPS never has to compile DSH; build compiles the
# Debian 13 image from this checkout instead.
DSH_IMAGE=ghcr.io/univers629/dsh-docker:latest
DSH_IMAGE_SOURCE=prebuilt

# Written by the installer's upgrade action: the RepoDigest of the image the
# container is actually running, so the next upgrade can tell whether the image
# really changed. Locally built images have no RepoDigest, so it stays absent.
# DSH_IMAGE_DIGEST=

# Host interface used for the DSH Docker port. Keep this private: the
# authenticated reverse proxy should be the only public entry point.
DSH_BIND_HOST=127.0.0.1

# local: private/local access only; trusted-proxy: authentication is handled
# by Cloudflare Access or another outer proxy; basic: built-in Nginx Basic Auth
# using the bcrypt file generated at data/auth/htpasswd.
DSH_ACCESS_MODE=local

# Optional: share a private Docker network with a reverse-proxy container.
# For DPanel, use DSH_DOCKER_NETWORK=dpanel-local and set the external flag to
# true, then configure the site upstream as http://dsh:3080.
DSH_DOCKER_NETWORK=dsh-private
DSH_DOCKER_NETWORK_EXTERNAL=false

# Public authorities served by the tunnel or reverse proxy.
# Use comma-separated host[:port] entries when more than one is needed.
# Leave empty when DSH is only accessed through loopback.
DSH_TRUSTED_HOSTS=

# Runtime facts are auto-detected inside the Debian container and rendered into
# the deployed container-environment skill. Override only for a deliberate
# cross-build or emulation setup.
DSH_SYSTEM_ARCH=
DSH_SYSTEM_PACKAGE_ARCH=
DSH_SYSTEM_ABI=
DSH_SYSTEM_LIBC=
DSH_SYSTEM_OS=
DSH_SYSTEM_RELEASE=

# The DSH sandbox remains inside the container. These values are descriptive
# policy inputs; they do not grant host access or Docker socket access.
DSH_PERMISSION_MODE=danger-full-access
DSH_HOST_ACCESS=mounted-paths-only
DSH_WRITABLE_PATHS=/data/dsh,/data/home,/data/mcp,/data/agents,/workspace

# DSH itself runs as the unprivileged dsh account (1000:1000). Privileged work
# goes through a root helper that only accepts an allow list. These two flags
# decide whether that helper also demands the container root password.
# nopasswd keeps apt and DSH updates usable without human interaction, which is
# what the Agent needs; password makes every escalation interactive.
# Anything outside the allow list always needs the root password, which is set
# with install.sh --root-password / install.ps1 -RootPassword and stored as a
# sha512crypt hash in data/secret/root.hash, never in this file.
DSH_PRIVILEGED_APT=nopasswd
DSH_PRIVILEGED_UPDATE=nopasswd

# ---- Model key broker ----
# off (default) keeps model API keys in DSH's own configuration. The Agent in
# the container runs with danger-full-access, so a single cat reads them; prompt
# injection needs no trick for that.
# on makes the installer overlay docker-compose.keys.yml and run the separate
# dsh-key-broker container. The real keys then exist only in
# data/broker/keys.json on the host (mode 0600; data/ is already gitignored) and
# in that container's memory, mounted read-only at its /etc/dsh-broker and never
# mounted into the DSH container. On the DSH side the model base_url becomes
# <DSH_MODEL_BROKER_BASE>/u/<upstream-name> with a placeholder api key, which the
# installer writes into data/dsh/settings.yaml and data/dsh/.credentials.yaml for
# you. The version segment stays in the broker's upstream address.
# Real model keys never belong in this file, only in data/broker/keys.json.
DSH_MODEL_BROKER=off

# Address of the broker on the Docker network. It is also rendered into the
# deployed container-environment skill so the Agent knows where model requests
# go. Change it only after renaming the container or its port.
DSH_MODEL_BROKER_BASE=http://dsh-key-broker:8080

# Upper bound on requests the broker keeps in flight. Anything above it returns
# 503 immediately instead of queueing and growing memory. 64 is enough for a
# single user; raise it for many concurrent sessions.
DSH_BROKER_MAX_CONCURRENT=64

# ---- Model key admin panel ----
# off (default) means model keys can only be entered from the installer wizard
# on the host. on makes the installer overlay docker-compose.keys-admin.yml and
# run the separate dsh-key-admin container, which serves a small browser panel
# for adding upstreams, keys, model ids, fixed request headers, and for fetching
# an upstream's model list once. It writes the same data/broker/keys.json plus
# DSH's data/dsh/settings.yaml and .credentials.yaml, so nothing has to be typed
# twice. It is deliberately not part of DSH's own WebUI: that page runs inside
# the dsh container, where the Agent could read whatever is typed into it.
# The panel joins only the dsh-admin network, which the dsh container is not on,
# and the installer verifies from inside dsh that the panel is unreachable.
# Requires DSH_MODEL_BROKER=on.
DSH_KEY_ADMIN=off

# Host interface and port for the panel. Keep the bind host on loopback and use
# an SSH tunnel for remote access: publishing it on 0.0.0.0 also lets the dsh
# container reach the panel back through the host gateway, which defeats the
# network isolation above. Access always needs the bearer token in
# data/broker/admin.token (mode 0600), which is never written into this file.
DSH_KEY_ADMIN_BIND_HOST=127.0.0.1
DSH_KEY_ADMIN_HOST_PORT=3082

# ---- Outbound mode ----
# open (default) lets the container reach the internet like any other Docker
# container. An injected Agent can POST data anywhere and can bypass the key
# broker to talk to a model provider directly.
# blocklist and allowlist both make the installer overlay
# docker-compose.isolated.yml. The dsh container is then attached only to the
# internal network, which has no default gateway, so a direct connection cannot
# work at all: outbound traffic must pass the dsh-egress forward proxy. Host port
# 3080 is published by the dsh-ingress container instead, which carries the dsh
# network alias on dsh-private, so reverse proxies configured with
# http://dsh:3080 (DPanel and similar) keep working unchanged.
# The two isolated modes differ only in the last gate: allowlist requires the
# destination domain to be on the allow list, blocklist only requires it to be
# absent from the block list (which ships with the common one-command public
# tunnel services). Everything else stays the same in both: IP literal targets,
# localhost, internal domain suffixes, ports other than 80/443, and domains that
# resolve into a private network are always rejected.
# Only open <-> isolated needs the installer; allowlist <-> blocklist and both
# lists live in data/egress/policy.json and are hot-reloaded, so the key admin
# panel can change them without recreating anything.
DSH_EGRESS_MODE=open

# Outbound domain allow list, comma-separated, with *.example.com style
# leftmost wildcards that do not match bare example.com.
# The built-in list holds 15 domains covering Debian, npm, PyPI, GitHub/ghcr,
# astral.sh, and nodejs.org. Domains listed here are added on top of it, so
# apt, pip, and npm keep working; empty means the built-in list only.
# Only domains are accepted: IP literals, localhost, and the .internal or
# .local suffixes are rejected as invalid entries and the proxy refuses to
# start.
# This is the fallback for deployments without data/egress/policy.json. Once
# that file exists it is authoritative and this value is ignored.
DSH_EGRESS_ALLOWED_HOSTS=

# How DSH_EGRESS_ALLOWED_HOSTS combines with the built-in list.
# append (default) keeps the built-in domains; replace drops them, which means
# every domain apt, pip, and npm need must be listed above.
DSH_EGRESS_ALLOWED_HOSTS_MODE=append

# Allowed destination ports, comma-separated. Empty means CONNECT on 443 only
# and plain HTTP forwarding on 80 and 443, because a fair number of Debian
# mirrors still serve over port 80.
DSH_EGRESS_ALLOWED_PORTS=

# Maximum number of connections through the proxy at once. Requests above the
# limit get 503, which keeps the container from exhausting proxy sockets.
DSH_EGRESS_MAX_SOCKETS=256

# DNS rebinding guard, 0 (guard enabled) by default. The allow list matches
# domains, and a domain can resolve into a private network, so the resolved
# addresses are checked before connecting and only public unicast addresses are
# accepted: loopback, private, link-local (including the cloud metadata address
# 169.254.169.254), CGNAT, and IPv4-mapped private ranges return 403.
# Setting this to 1 gives up that protection, which is only appropriate when the
# allow list genuinely points at an internal mirror on the same network.
DSH_EGRESS_ALLOW_PRIVATE_UPSTREAM=0

# Name of the bridge network that only carries the key admin panel. The dsh
# container never joins it, which is what keeps the panel unreachable from the
# agent. Rename it only when running several stacks on one host.
DSH_ADMIN_NETWORK=dsh-admin

# Name of the internal network (internal: true, no default gateway) that carries
# east-west traffic between dsh and dsh-key-broker, dsh-egress, and dsh-ingress.
# Rename it only when running several stacks on one host.
DSH_INTERNAL_NETWORK=dsh-internal
