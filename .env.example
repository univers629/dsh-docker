# Host interface used for the DSH Docker port. Keep this private: the
# authenticated reverse proxy should be the only public entry point.
DSH_BIND_HOST=127.0.0.1

# local: private/local access only; trusted-proxy: authentication is handled
# by Cloudflare Access or another outer proxy; basic: built-in Nginx Basic Auth
# using the bcrypt file generated at data/auth/htpasswd.
DSH_ACCESS_MODE=local

# Optional: share a private Docker network with a reverse-proxy container.
# For DPanel, use DSH_DOCKER_NETWORK=dpanel-local and set the external flag to
# true, then configure the site upstream as http://dsh:3080.
DSH_DOCKER_NETWORK=dsh-private
DSH_DOCKER_NETWORK_EXTERNAL=false

# Public authorities served by the tunnel or reverse proxy.
# Use comma-separated host[:port] entries when more than one is needed.
# Leave empty when DSH is only accessed through loopback.
DSH_TRUSTED_HOSTS=

# DSH process UID inside the container. Root is the default; set false to use
# the unprivileged node user. This never grants root on the host.
DSH_RUN_AS_ROOT=true

# Runtime facts are auto-detected inside the Debian container and rendered into
# the deployed container-environment skill. Override only for a deliberate
# cross-build or emulation setup.
DSH_SYSTEM_ARCH=
DSH_SYSTEM_PACKAGE_ARCH=
DSH_SYSTEM_ABI=
DSH_SYSTEM_LIBC=
DSH_SYSTEM_OS=
DSH_SYSTEM_RELEASE=

# The DSH sandbox remains inside the container. These values are descriptive
# policy inputs; they do not grant host access or Docker socket access.
DSH_PERMISSION_MODE=danger-full-access
DSH_HOST_ACCESS=mounted-paths-only
DSH_WRITABLE_PATHS=/data/dsh,/data/home,/data/mcp,/data/agents,/workspace
